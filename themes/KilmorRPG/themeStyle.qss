/* KilmorRPG Amethyst theme. Original scene artwork will be packaged separately. */
QMainWindow, QWidget#centralWidget {
    background-color: #171020;
    color: #eee4ff;
}
QWidget#centralWidget {
    background-color: #171020;
}

/* Keep the instance browser translucent so a packaged KilmorRPG artwork layer
   can show through without replacing the launcher's real instance widgets. */
QWidget#centralWidget QAbstractScrollArea,
QWidget#centralWidget QTreeView,
QWidget#centralWidget QListView {
    background-color: rgba(20, 12, 30, 145);
}
QAbstractItemView, QListView, QTreeView, QTableView {
    background-color: rgba(20, 12, 30, 165);
    color: #eee4ff;
    alternate-background-color: rgba(42, 24, 58, 175);
    border: 1px solid #8150a9;
    selection-background-color: rgba(125, 62, 177, 220);
    selection-color: #ffffff;
    outline: 0;
}
QToolBar {
    background-color: rgba(27, 17, 40, 225);
    border: 1px solid #68418c;
    spacing: 7px;
    padding: 5px;
}
QToolBar QToolButton, QPushButton {
    color: #f4eaff;
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #624080, stop:0.45 #43265f, stop:1 #2a1a3b);
    border: 1px solid #b17cdb;
    border-top-color: #d2a5f1;
    border-bottom-color: #4b2d68;
    border-radius: 7px;
    padding: 7px 12px;
    min-height: 24px;
}
QToolBar QToolButton:hover, QPushButton:hover {
    background-color: #71459a;
    border-color: #e0b9ff;
}
QToolBar QToolButton:pressed, QPushButton:pressed {
    background-color: #321b49;
    border-color: #a86bda;
    padding-top: 8px;
    padding-bottom: 6px;
}
QMenuBar, QMenu {
    background-color: #21152e;
    color: #eee4ff;
}
QMenu::item:selected, QMenuBar::item:selected {
    background-color: #69408c;
}
QStatusBar {
    background-color: rgba(22, 14, 32, 230);
    color: #cdb5e6;
    border-top: 1px solid #68418c;
}
QLineEdit, QComboBox, QSpinBox, QPlainTextEdit, QTextEdit {
    background-color: #1c1327;
    color: #f4eaff;
    border: 1px solid #755093;
    border-radius: 5px;
    padding: 5px;
}
QHeaderView::section {
    background-color: #352344;
    color: #eee4ff;
    border: 1px solid #68418c;
    padding: 5px;
}


/* KilmorRPG stone-and-amethyst home screen */
QFrame#kilmorSidebar {
    background-color: rgba(24, 15, 34, 238);
    border-right: 2px solid #79509a;
}
QLabel#kilmorEyebrow {
    color: #c9a4e8;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 2px;
}
QLabel#kilmorBrand {
    color: #f5eaff;
    font-size: 27px;
    font-weight: 900;
}
QLabel#kilmorSubtitle {
    color: #b994d7;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 3px;
}
QPushButton#kilmorNavButton {
    text-align: left;
    padding: 10px 14px;
    color: #f1e5fb;
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #51405d, stop:0.16 #3b2d46, stop:0.85 #292032, stop:1 #1d1725);
    border: 1px solid #80649a;
    border-top-color: #b49ac8;
    border-bottom: 3px solid #17111d;
    border-radius: 4px;
    font-weight: 700;
}
QPushButton#kilmorNavButton:hover {
    background-color: #624777;
    border-color: #d1a6f0;
}
QPushButton#kilmorNavButton:pressed {
    padding-top: 12px;
    border-bottom-width: 1px;
}
QWidget#kilmorContent {
    background-color: rgba(18, 12, 26, 105);
}
QWidget#kilmorLaunchBar {
    background-color: rgba(28, 18, 40, 225);
    border: 1px solid #76518f;
    border-top: 2px solid #a47ac2;
    border-radius: 5px;
    padding: 8px;
}
QLabel#kilmorLaunchHint {
    color: #d7c4e8;
    font-size: 12px;
}
QPushButton#kilmorMainPlayButton {
    color: #fff8ff;
    font-size: 17px;
    font-weight: 900;
    letter-spacing: 2px;
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #8760a3, stop:0.12 #65447e, stop:0.8 #382347, stop:1 #24172e);
    border: 2px solid #c39add;
    border-top-color: #e0c2f5;
    border-bottom: 4px solid #17101f;
    border-radius: 5px;
    padding: 8px 24px;
}
QPushButton#kilmorMainPlayButton:hover {
    background-color: #8055a1;
    border-color: #f0d9ff;
}
QPushButton#kilmorMainPlayButton:pressed {
    padding-top: 11px;
    border-bottom-width: 1px;
}
QLabel#kilmorVersion {
    color: #aa91bd;
    font-size: 10px;
}
